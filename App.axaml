<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Unqueued.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Unqueued/Assets/Marks.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="Cinzel">avares://Unqueued/Assets/Fonts/Cinzel-Regular.ttf#Cinzel, avares://Unqueued/Assets/Fonts/Cinzel-Bold.ttf#Cinzel</FontFamily>
            <FontFamily x:Key="Plex">avares://Unqueued/Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans, avares://Unqueued/Assets/Fonts/IBMPlexSans-Medium.ttf#IBM Plex Sans</FontFamily>
            <!-- color-hex.com/color-palette/8528 -->
            <Color x:Key="WasdMint">#0AC8B9</Color>
            <Color x:Key="WasdTeal">#0397AB</Color>
            <Color x:Key="WasdDeep">#005A82</Color>
            <Color x:Key="WasdPanel">#0A323C</Color>
            <Color x:Key="WasdInk">#091428</Color>
            <Color x:Key="WasdText">#E8FBFA</Color>
            <SolidColorBrush x:Key="WasdMintBrush" Color="{StaticResource WasdMint}" />
            <SolidColorBrush x:Key="WasdTealBrush" Color="{StaticResource WasdTeal}" />
            <SolidColorBrush x:Key="WasdDeepBrush" Color="{StaticResource WasdDeep}" />
            <SolidColorBrush x:Key="WasdPanelBrush" Color="{StaticResource WasdPanel}" />
            <SolidColorBrush x:Key="WasdInkBrush" Color="{StaticResource WasdInk}" />
            <SolidColorBrush x:Key="WasdTextBrush" Color="{StaticResource WasdText}" />
            <LinearGradientBrush x:Key="WasdGradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#0AC8B9" Offset="0" />
                <GradientStop Color="#0397AB" Offset="0.55" />
                <GradientStop Color="#005A82" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="Foreground" Value="{StaticResource WasdTextBrush}" />
            <Setter Property="Background" Value="{StaticResource WasdInkBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WasdTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WasdMintBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A323C" />
            <Setter Property="BorderBrush" Value="#0AC8B9" />
            <Setter Property="Foreground" Value="#E8FBFA" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#005A82" />
            <Setter Property="Foreground" Value="#E8FBFA" />
        </Style>

        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WasdMintBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8FBFA" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0A323C" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/unqueued.ico"
                      ToolTipText="Unqueued — a WASD app"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Click="OnOpenRitual" />
                        <NativeMenuItem Header="Pass" Click="OnPassFromTray" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit — stops protection" Click="OnQuit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
