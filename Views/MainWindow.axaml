<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Unqueued.ViewModels"
        xmlns:controls="using:Unqueued.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="440" d:DesignHeight="640"
        x:Class="Unqueued.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/unqueued.png"
        Title="wasdlol skip"
        Width="440"
        Height="640"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#010A13"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <controls:CutCornerFrame x:Name="Shell"
                             CutSize="22"
                             StrokeThickness="1.4"
                             Stroke="#C8AA6E"
                             Fill="#010A13"
                             PointerPressed="OnChromePointerPressed">
        <controls:CutCornerFrame Margin="9"
                                 CutSize="13"
                                 StrokeThickness="0.7"
                                 Stroke="#C8AA6E"
                                 Fill="#070B12"
                                 ShowCornerMarks="False">
            <Grid RowDefinitions="Auto,*" Margin="18,16,18,20">
                <Grid Grid.Row="0" Background="Transparent" PointerPressed="OnChromePointerPressed">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,56,0">
                        <controls:WasdMark Width="26"
                                           Height="26"
                                           VerticalAlignment="Center"
                                           HexFill="#010A13"
                                           Accent="#C8AA6E"
                                           KeyFill="#16110A" />
                        <TextBlock Text="wasdlol skip"
                                   FontFamily="{StaticResource Plex}"
                                   FontSize="14"
                                   LetterSpacing="1.2"
                                   Foreground="#C8AA6E"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="2"
                                Margin="0,0,6,0">
                        <Button Classes="caption" Click="OnMinimizeClick">
                            <Rectangle Width="11"
                                       Height="1.4"
                                       Fill="#C8AA6E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="caption close" Command="{Binding CloseToTrayCommand}">
                            <Path Stroke="#C8AA6E"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  Width="11"
                                  Height="11"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,*,Auto,Auto"
                      Margin="6,18,6,0">

                    <TextBlock Grid.Row="0"
                               Text="{Binding Eyebrow}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="11"
                               LetterSpacing="2.4"
                               Foreground="#C8AA6E"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <Grid Grid.Row="1" Margin="0,8">
                        <controls:HexRing Stroke="#C8AA6E" Margin="36" />
                        <Viewbox Stretch="Uniform" MaxHeight="200" Margin="64,36">
                            <TextBlock Text="{Binding StreakDays}"
                                       FontFamily="{StaticResource Cinzel}"
                                       FontWeight="Bold"
                                       FontSize="120"
                                       Foreground="{StaticResource GoldGradient}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Viewbox>
                    </Grid>

                    <Button Grid.Row="2"
                            Classes="primary"
                            Margin="0,8,0,0"
                            Content="Skip lol today"
                            Command="{Binding SkipTodayCommand}" />

                    <Button Grid.Row="3"
                            Classes="quiet"
                            Margin="0,12,0,8"
                            Content="Play"
                            Command="{Binding PlayCommand}" />
                </Grid>
            </Grid>
        </controls:CutCornerFrame>
    </controls:CutCornerFrame>
</Window>
