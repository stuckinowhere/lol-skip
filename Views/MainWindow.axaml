<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Unqueued.ViewModels"
        xmlns:controls="using:Unqueued.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="420" d:DesignHeight="560"
        x:Class="Unqueued.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/unqueued.ico"
        Title="Unqueued"
        Width="420"
        Height="560"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#010A13"
        TransparencyLevelHint="None"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <controls:CutCornerFrame Margin="10" CutSize="18" StrokeThickness="1.2" Stroke="#C8AA6E">
            <controls:CutCornerFrame Margin="8" CutSize="12" StrokeThickness="0.6" Stroke="#C8AA6E">
                <Grid RowDefinitions="Auto,*" Margin="18,14,18,36">
                    <Grid Grid.Row="0"
                          Background="Transparent"
                          PointerPressed="OnChromePointerPressed">
                        <TextBlock Text="UNQUEUED"
                                   FontFamily="{StaticResource Plex}"
                                   FontSize="11"
                                   LetterSpacing="4"
                                   Foreground="#C8AA6E"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="4,2,40,2" />
                        <Button Classes="icon"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding CloseToTrayCommand}"
                                ToolTip.Tip="Keep League blocked and hide to the tray">
                            <Path Stroke="#C8AA6E"
                                  StrokeThickness="1.2"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                        </Button>
                    </Grid>

                    <Panel Grid.Row="1">
                        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto"
                              IsVisible="{Binding !IsConfirming}"
                              Margin="8,20,8,4">
                            <StackPanel Grid.Row="0" Spacing="6">
                                <TextBlock Text="{Binding Eyebrow}"
                                           FontFamily="{StaticResource Plex}"
                                           FontSize="11"
                                           LetterSpacing="3.2"
                                           Foreground="#C8AA6E"
                                           Opacity="0.9"
                                           HorizontalAlignment="Center" />
                                <Rectangle Width="36" Height="1" Fill="#C8AA6E" Opacity="0.7" HorizontalAlignment="Center" />
                            </StackPanel>

                            <Viewbox Grid.Row="1"
                                     Stretch="Uniform"
                                     MaxHeight="210"
                                     Margin="0,8">
                                <TextBlock Text="{Binding StreakDays}"
                                           FontFamily="{StaticResource Cinzel}"
                                           FontWeight="Bold"
                                           FontSize="132"
                                           Foreground="#C8AA6E"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Viewbox>

                            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,28">
                                <TextBlock Text="{Binding StatusLine}"
                                           FontFamily="{StaticResource Plex}"
                                           FontSize="14"
                                           Foreground="#F0E6D2"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetailLine}"
                                           FontFamily="{StaticResource Plex}"
                                           FontSize="12"
                                           Foreground="#C8AA6E"
                                           Opacity="0.8"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="3"
                                    Classes="primary"
                                    Content="{Binding PrimaryLabel}"
                                    Command="{Binding StayCommand}" />

                            <Button Grid.Row="4"
                                    Classes="quiet"
                                    Content="Pass"
                                    Margin="0,10,0,6"
                                    IsVisible="{Binding !IsAllowed}"
                                    Command="{Binding BeginPassConfirmCommand}" />
                        </Grid>

                        <Grid RowDefinitions="*,Auto,Auto,Auto"
                              IsVisible="{Binding IsConfirming}"
                              Margin="12,28,12,8">
                            <StackPanel Grid.Row="0"
                                        VerticalAlignment="Center"
                                        Spacing="14">
                                <TextBlock Text="PASS"
                                           FontFamily="{StaticResource Plex}"
                                           FontSize="11"
                                           LetterSpacing="4"
                                           Foreground="#C8AA6E"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Resets your streak to 0. League is allowed until midnight."
                                           FontFamily="{StaticResource Plex}"
                                           FontSize="16"
                                           Foreground="#F0E6D2"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           LineHeight="24" />
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Classes="primary"
                                    Content="Allow League today"
                                    Command="{Binding ConfirmPassCommand}" />
                            <Button Grid.Row="2"
                                    Classes="quiet"
                                    Content="Never mind"
                                    Margin="0,10,0,8"
                                    Command="{Binding CancelPassCommand}" />
                        </Grid>
                    </Panel>
                </Grid>
            </controls:CutCornerFrame>
        </controls:CutCornerFrame>

        <TextBlock Text="{Binding Footer}"
                   FontFamily="{StaticResource Plex}"
                   FontSize="10"
                   Foreground="#C8AA6E"
                   Opacity="0.55"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="28,0,28,16"
                   IsHitTestVisible="False" />
    </Panel>
</Window>
